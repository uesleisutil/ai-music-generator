[flake8]
max-line-length = 127
max-complexity = 20
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    *.egg-info,
    output
per-file-ignores =
    __init__.py:F401
    **/generate_*.py:F401,F541,F841
    **/pipeline*.py:F811
    **/check_models.py:F541
    **/test_*.py:F541
ignore =
    E501,
    W503,
    E203,
    C901,
    E402,
    W293,
    W291,
    E302,
    E305,
    E128
