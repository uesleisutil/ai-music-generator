#!/usr/bin/env python3
"""
AI Music Generator - Main CLI entry point
"""

import sys
import os

# Add project root to path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

def main():
    import argparse
    
    parser = argparse.ArgumentParser(
        description='AI Music Generator - Generate music, images, and videos with AI',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Quick test (no AI)
  aimusic simple --prompt "lofi music" --duration 30
  
  # With AI (preset)
  aimusic ai --prompt "jazz piano" --preset balanced --duration 60
  
  # With AI (custom models)
  aimusic ai --prompt "rock" --music-model musicgen-large --image-model sd-xl-base
  
  # List available models
  aimusic models
  
  # Check installed models
  aimusic check
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Commands')
    
    # Simple pipeline
    simple_parser = subparsers.add_parser('simple', help='Quick generation without AI')
    simple_parser.add_argument('--prompt', required=True, help='Music description')
    simple_parser.add_argument('--duration', type=int, default=30, help='Duration in seconds')
    simple_parser.add_argument('--title', help='Video title')
    simple_parser.add_argument('--skip-upload', action='store_true', help='Skip YouTube upload')
    
    # AI pipeline
    ai_parser = subparsers.add_parser('ai', help='Generation with AI models')
    ai_parser.add_argument('--prompt', required=True, help='Music description')
    ai_parser.add_argument('--duration', type=int, default=30, help='Duration in seconds')
    ai_parser.add_argument('--title', help='Video title')
    ai_parser.add_argument('--preset', choices=['quick', 'balanced', 'quality', 'experimental'])
    ai_parser.add_argument('--music-model', help='Music model to use')
    ai_parser.add_argument('--image-model', help='Image model to use')
    ai_parser.add_argument('--skip-upload', action='store_true', help='Skip YouTube upload')
    
    # List models
    subparsers.add_parser('models', help='List available models')
    
    # Check models
    subparsers.add_parser('check', help='Check installed models')
    
    # Test setup
    subparsers.add_parser('test', help='Test system setup')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    if args.command == 'simple':
        from src.pipeline_simple import run_simple_pipeline
        run_simple_pipeline(
            args.prompt,
            args.duration,
            args.title,
            skip_upload=args.skip_upload
        )
    
    elif args.command == 'ai':
        from src.pipeline_ai import run_ai_pipeline
        run_ai_pipeline(
            args.prompt,
            args.duration,
            args.title,
            skip_upload=args.skip_upload,
            music_model=args.music_model,
            image_model=args.image_model,
            preset=args.preset
        )
    
    elif args.command == 'models':
        from scripts.list_models import main as list_main
        list_main()
    
    elif args.command == 'check':
        from scripts.check_models import main as check_main
        check_main()
    
    elif args.command == 'test':
        from tests.test_setup import main as test_main
        test_main()

if __name__ == '__main__':
    main()
